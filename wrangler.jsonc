{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "name": "sanctify-pwa",
  "compatibility_date": "2025-03-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://sanctify-pwa.catholic-streaming.workers.dev,http://localhost:5173",
    "R2_BUCKET_NAME": "sanctify-media"
  }
}
