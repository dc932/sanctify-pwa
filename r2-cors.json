{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://sanctify-pwa.catholic-streaming.workers.dev",
          "http://localhost:5173"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Range", "x-amz-*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
